# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Datos de trabajo EFÍMEROS (regeneración) — NO versionar.
backend/data/raw/*.json
backend/data/processed/

# Base de conocimiento FIJA y versionada — SÍ se versiona (fuente de verdad).
# Es la excepción explícita a las reglas anteriores.
!backend/data/versioned/
!backend/data/versioned/**

# Entornos / secretos
.env
*.local

# SO / editores
.DS_Store
